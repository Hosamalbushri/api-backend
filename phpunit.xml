<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>packages/NexaBiz/Core/tests</directory>
            <directory>packages/NexaBiz/Identity/tests</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>packages/NexaBiz/Synchronization/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>packages</directory>
        </include>
    </source>
    <php>
        <!-- force=true so production/cPanel env vars cannot leak into tests -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/Ej30Tes4O1gVlO/9j4C6AKEiQ=" force="true"/>
        <env name="ALLOW_DEV_TOKEN" value="true" force="true"/>
        <env name="DEV_API_TOKEN" value="test-token" force="true"/>
        <env name="AUTH_RATE_LIMIT_PER_MINUTE" value="0" force="true"/>
        <env name="JWT_SECRET" value="test-jwt-secret-change-me-please-use-long-random" force="true"/>
        <env name="JWT_ISSUER" value="nexabiz-experimental" force="true"/>
        <env name="CORS_ORIGINS" value="*" force="true"/>
        <env name="SEED_ON_BOOT" value="false" force="true"/>
        <env name="SEED_ADMIN_PASSWORD" value="ChangeMeAdmin!123" force="true"/>
    </php>
</phpunit>
